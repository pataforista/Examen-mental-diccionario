  "definition_clinical": {
    "core": "Umbral reducido para la respuesta de frustración o enojo ante estímulos mínimos. Puede manifestarse como hostilidad verbal, explosiones de ira o simplemente tensión sostenida. Síntoma transnosológico presente en depresión (especialmente en niños/adolescentes y depresión atípica), manía, TEPT, TDAH, patología orgánica.",
    "required_features": [
      "umbral reducido para frustración",
      "respuesta de enojo desproporcionada",
      "persistente o recurrente"
    ],
    "subjective_marker": "El paciente refiere 'saltar' por cosas pequeñas, sentirse 'al límite', todo le molesta.",
    "behavioral_marker": "Estallidos verbales, gestos bruscos, quejas frecuentes, conflictos interpersonales aumentados."
  },
