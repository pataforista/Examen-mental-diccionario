  "definition_clinical": {
    "core": "Discordancia entre el afecto expresado y el contenido del pensamiento o la situación. El paciente ríe al relatar la muerte de un familiar o llora sin causa aparente. Signo clásico de esquizofrenia desorganizada.",
    "required_features": [
      "discordancia afecto-contenido",
      "no explicable por contexto cultural",
      "persistente"
    ],
    "subjective_marker": "El paciente frecuentemente no reporta la incongruencia; puede no tener conciencia de ella.",
    "behavioral_marker": "Sonrisa o risa ante temas trágicos; llanto ante temas neutros; expresiones afectivas desconectadas del contexto."
  },
