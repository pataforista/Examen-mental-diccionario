{
  "name": "examen-mental-diccionario",
  "version": "1.0.0",
  "description": "Diccionario clínico de examen mental: semiología, integrador de 20 puntos, casos OSCE y entrenamiento. PWA sin conexión.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src sw.js",
    "validate": "node scripts/validate_terms.js",
    "test": "npm run lint && npm run validate && npm run contrast && npm run blacklist",
    "contrast": "node scripts/check_contrast.js",
    "blacklist": "node scripts/check_blacklist.js",
    "build:lexicon": "node scripts/optimize_lexicon.js",
    "test:pwa": "node scripts/test_pwa_dialog.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pataforista/Examen-mental-diccionario.git"
  },
  "keywords": [
