  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/pataforista/Examen-mental-diccionario/issues"
  },
  "homepage": "https://github.com/pataforista/Examen-mental-diccionario#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "vite": "^8.1.4"
  }
}
